# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# Training run artifacts (saved models, checkpoints, monitor logs,
# normalization stats) — these are large and fully reproducible, so they
# are generated locally and never committed. The folder README stays tracked.
models/*
!models/README.md

# Experiment data — commit summaries, not raw logs or generated plots
data/raw/
data/*.png

# MuJoCo viewer dumps — the 3D viewer writes these into the working directory
# when you save/inspect model state. They are regenerated on demand and are
# just noise in `git status`.
MJDATA.TXT
MJMODEL.TXT
mjmodel.mjb
mjmodel.xml

# Ad-hoc screenshots
screenshot.png

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
